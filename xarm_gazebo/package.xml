<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xarm_gazebo</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="vinman.cub@gmail.com">vm</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>controller_manager</depend>
  <depend>xarm_description</depend>
  <depend>xarm_controller</depend>

  <!-- control_toolbox, gazebo, and gazebo_ros build/run the classic-Gazebo-only
       gazebo_mimic_joint_plugin (see CMakeLists.txt); not required for gz-sim/Harmonic
       launches (gz_type=gz), so left undeclared here to keep this package - and
       xarm_moveit_config, which depends on it - installable on a Harmonic-only system.
       Install them manually (e.g. ros-humble-gazebo-ros-pkgs) if you need the classic
       Gazebo launch path (gz_type=gazebo). Same reasoning for gazebo_plugins and
       gazebo_ros2_control below, which that path also needs. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>uf_ros_lib</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
